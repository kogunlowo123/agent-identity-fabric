{
  "$defs": {
    "AgentMandate": {
      "description": "Role, mission and operating boundaries recorded at registration.",
      "properties": {
        "business_owner": {
          "minLength": 3,
          "title": "Business Owner",
          "type": "string"
        },
        "disallowed_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Disallowed Actions",
          "type": "array"
        },
        "escalation_contact": {
          "minLength": 3,
          "title": "Escalation Contact",
          "type": "string"
        },
        "mission": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Mission",
          "type": "string"
        },
        "protected_resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Protected Resources",
          "type": "array"
        },
        "technical_owner": {
          "minLength": 3,
          "title": "Technical Owner",
          "type": "string"
        }
      },
      "required": [
        "mission",
        "business_owner",
        "technical_owner",
        "escalation_contact"
      ],
      "title": "AgentMandate",
      "type": "object"
    },
    "DataClassification": {
      "description": "Sensitivity label. Ordered from least to most restricted.",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "DataClassification",
      "type": "integer"
    },
    "RiskLevel": {
      "description": "Action risk tier. Ordered so policies can compare with ``>=``.",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "RiskLevel",
      "type": "integer"
    },
    "WorkloadBinding": {
      "description": "Which runtime workload may claim this agent identity.",
      "properties": {
        "audience": {
          "description": "Audience the projected token must carry",
          "title": "Audience",
          "type": "string"
        },
        "image_digests": {
          "default": [],
          "description": "Allowed sha256 image digests; empty disables the check",
          "items": {
            "type": "string"
          },
          "title": "Image Digests",
          "type": "array",
          "uniqueItems": true
        },
        "issuer": {
          "description": "Workload token issuer, e.g. the cluster OIDC issuer URL",
          "title": "Issuer",
          "type": "string"
        },
        "subject": {
          "description": "e.g. system:serviceaccount:<namespace>:<name>",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "subject",
        "audience"
      ],
      "title": "WorkloadBinding",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/agent-identity-fabric/schemas/register-agent.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Display Name",
      "type": "string"
    },
    "mandate": {
      "$ref": "#/$defs/AgentMandate"
    },
    "max_classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "namespace": {
      "title": "Namespace",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scopes",
      "type": "array",
      "uniqueItems": true
    },
    "workload": {
      "$ref": "#/$defs/WorkloadBinding"
    }
  },
  "required": [
    "namespace",
    "name",
    "display_name",
    "mandate",
    "scopes",
    "risk",
    "max_classification",
    "workload"
  ],
  "title": "RegisterAgent",
  "type": "object"
}
